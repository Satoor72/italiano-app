{
  "name": "ncx-italiano",
  "productName": "IT Ncx",
  "version": "1.0.0",
  "description": "IT Ncx - تطبيق تعلم اللغة الإيطالية",
  "main": "main.js",
  "author": "Ncx",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.ncx.italiano",
    "productName": "IT Ncx",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "style.css",
      "data1.js",
      "data2.js",
      "app.js",
      "icon.svg",
      "manifest.json",
      "sw.js",
      "icon.png",
      "hero-bg.jpg",
      "icon-192.png",
      "apple-touch-icon.png",
      "favicon-32.png",
      "sections-bg.jpg"
    ],
    "win": {
      "icon": "icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IT Ncx"
    }
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  }
}
